{
	"name": "main-bar",
	"layer": "top",
	"position": "top",
	"spacing": 4,
	"height": 39,
	"margin-top": 4,
	"margin-bottom": -8,
	"exclusive": true,
	"passthrough": false,
	"reload_style_on_change": true,
	"include": ["~/.config/waybar/includes/modules.jsonc"],
	"modules-left": ["group/pill#launcher-workspace", "niri/window"],
	"modules-center": [],
	"modules-right": [
		"custom/screen-recorder",
		"group/pill#music",
		"tray",
		"group/pill#battery-group",
		"pulseaudio",
		"network",
		"custom/swaync",
		"clock",
	],
	"group/pill#music": {
		"orientation": "inherit",
		"modules": ["mpris#previous", "mpris#play-pause", "mpris#next", "mpris#alt"],
	},
	"group/pill#launcher-workspace": {
		"orientation": "inherit",
		"modules": ["custom/launcher", "niri/workspaces"],
	},
	"group/pill#battery-group": {
		"orientation": "inherit",
		"modules": ["battery", "battery#alt"],
	},
	"custom/screen-recorder": {
		"hide-empty-text": true,
		"format": "{icon}",
		"tooltip-format": "Screen Recorder: <b>{text}</b>\n<b>Right Click</b>: Record Region",
		"format-icons": {
			"recording": "󰕧",
			"default": "",
		},
	},
	"custom/launcher": {
		"format": "{icon}",
		"tooltip-format": "<big><b>Application Launcher</b></big>\nRight click for more actions",
	},
	"battery": {
		"format": "{icon}",
		"format-icons": {
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"plugged": "",
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
		},
		"tooltip-format": "Battery level: <b>{capacity}%</b>\nPower draw: <b>{power}W</b>\n({timeTo})",
	},
	"battery#alt": {
		"format": "{capacity}%",
		"tooltip-format": "Battery level: <b>{capacity}%</b>\nPower draw: <b>{power}W</b>\n({timeTo})",
		"on-scroll-up": "true",
		"on-scroll-down": "true",
	},
	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "",
		"format-icons": {
			"headphone": "󰋋",
			"headphone-muted": "",
			"hands-free": "󰋋",
			"hands-free-muted": "",
			"headset": "󰋋",
			"headset-muted": "",
			"phone": "",
			"phone-muted": "",
			"portable": "",
			"portable-muted": "",
			"car": "",
			"car-muted": "",
			"default": ["", "", ""],
		},
		"tooltip-format": "{desc}: {volume}%",
	},
	"niri/workspaces": {
		"cursor": false,
		"format": "{index}",
		"format-icons": {
			"default": "",
			// "active": "󰫢",
			"browser": "",
			"chat": "",
		},
	},
	"niri/window": {
		"format": "{title}",
		"max-length": 30,
	},
	"clock": {
		"format": "{:%a %I:%M %p}",
		"format-alt": "{:%H:%M}",
		"tooltip-format": "<tt>{calendar}</tt>",
	},
	"custom/swaync": {
		"format": "{icon}",
		"format-icons": {
			"notification": "󰅸",
			"none": "󰂜",
			"dnd-notification": "󰪑<sup>󰧞</sup>",
			"dnd-none": "󰪑",
			"inhibited-notification": "󰅸",
			"inhibited-none": "󰂜",
			"dnd-inhibited-notification": "󰪑<sup>󰧞</sup>",
			"dnd-inhibited-none": "󰪑",
		},
	},
	"mpris#play-pause": {
		"format": "{player_icon}",
		"format-paused": "{status_icon}",
		"player-icons": {
			"default": "󰏥",
		},
		"status-icons": {
			"paused": "󰐍",
		},
		"tooltip-format": "PLAYING [ {position} / {length} ]\n{title} - {artist}",
		"tooltip-format-paused": "PAUSED [ {position} / {length} ]\n{title} - {artist}",
		"on-click": "mediacontrol.sh toggle",
		"justify": "center",
	},
	"mpris#alt": {
		"format": "{title}",
		"tooltip-format": "PLAYING [ {position} / {length} ]\n{title} - {artist}",
		"tooltip-format-paused": "PAUSED [ {position} / {length} ]\n{title} - {artist}",
		"on-click": "mediacontrol.sh toggle",
		"max-length": 30,
	},
	"mpris#next": {
		"format": "󰒭",
		"format-stopped": "",
		"tooltip-format": "PLAYING [ {position} / {length} ]\n{title} - {artist}",
		"tooltip-format-paused": "PAUSED [ {position} / {length} ]\n{title} - {artist}",
		"on-click": "mediacontrol.sh next",
		"justify": "center",
	},
	"mpris#previous": {
		"format": "󰒮",
		"format-stopped": "",
		"tooltip-format": "PLAYING [ {position} / {length} ]\n{title} - {artist}",
		"tooltip-format-paused": "PAUSED [ {position} / {length} ]\n{title} - {artist}",
		"on-click": "mediacontrol.sh prev",
		"justify": "center",
	},
	"custom/sysupdate": {
		"format": "{icon}",
		"return-type": "json",
		"format-icons": {
			"has-updates": "󱧘",
			"updated": "",
		},
	},
	"tray": {
		"icon-size": 15,
		"spacing": 8,
	},
	"network": {
		"format": "{icon}",
		"format-icons": {
			"wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
			"ethernet": "󰈁",
			"linked": "󰈁",
			"disconnected": "󰤮",
		},
		"tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\nUpload speed: <b>{bandwidthUpBytes}</b>\nDownload speed: <b>{bandwidthDownBytes}</b>",
		"tooltip-format-disconnected": "Disconnected",
	},
}
